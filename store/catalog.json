    {
      "name": "confetti",
      "icon": "🎉",
      "desc": "紙吹雪がパッと舞う（1回きり・自動で消える）",
      "author": "kinoshita studio",
      "tag": "featured",
      "action": "const vc=BM.viewCenter();const cols=['#FF5C5C','#FFD24C','#5CC8FF','#9B5CFF','#5CFF9B','#FF7CE0'];const parts=[];for(let i=0;i<44;i++){const o=BM.create('square',{x:vc.x,y:vc.y-220,w:9+Math.random()*8,h:5+Math.random()*6,fill:cols[i%cols.length]});parts.push({o,vx:(Math.random()-0.5)*12,vy:-7-Math.random()*7});}let f=0;const id=setInterval(()=>{f++;for(const p of parts){p.vy+=0.5;p.o.data.x+=p.vx;p.o.data.y+=p.vy;p.o.data.rotation=(p.o.data.rotation||0)+p.vx*0.12;}BM.redraw();if(f>64){clearInterval(id);const all=BM.all();for(const p of parts){const i=all.indexOf(p.o);if(i>=0)all.splice(i,1);}BM.redraw();BM.log('🎉');}},30);"
    },
    {
      "name": "fireworks",
      "icon": "🎆",
      "desc": "花火が中央で弾ける（1回きり）",
      "author": "kinoshita studio",
      "tag": "featured",
      "action": "const vc=BM.viewCenter();const cx=vc.x+BM.rand(-160,160),cy=vc.y+BM.rand(-140,20);const cols=['#FF5C5C','#FFD24C','#5CC8FF','#9B5CFF','#5CFF9B','#FF7CE0'];const parts=[];for(let i=0;i<34;i++){const a=Math.PI*2*i/34,sp=4+Math.random()*4.5;const o=BM.create('circle',{cx,cy,rx:5,ry:5,fill:cols[i%cols.length]});parts.push({o,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp});}let f=0;const id=setInterval(()=>{f++;for(const p of parts){p.vy+=0.16;p.o.data.cx+=p.vx;p.o.data.cy+=p.vy;p.o.data.rx=Math.max(0.5,p.o.data.rx*0.955);p.o.data.ry=p.o.data.rx;}BM.redraw();if(f>48){clearInterval(id);const all=BM.all();for(const p of parts){const i=all.indexOf(p.o);if(i>=0)all.splice(i,1);}BM.redraw();BM.log('🎆');}},30);"
    },
    {
      "name": "ripple",
      "icon": "🌊",
      "desc": "中央から波紋が広がり続ける（もう一度で停止）",
      "author": "kinoshita studio",
      "tag": "new",
      "action": "if(window._rippleId){clearInterval(window._rippleId);window._rippleId=null;if(window._rippleObjs){const all=BM.all();for(const o of window._rippleObjs){const i=all.indexOf(o);if(i>=0)all.splice(i,1);}window._rippleObjs=null;BM.redraw();}BM.log('ripple stopped');return;}const vc=BM.viewCenter();const rings=[];window._rippleObjs=[];window._rippleId=setInterval(()=>{if(rings.length<7&&Math.random()<0.45){const o=BM.create('circle',{cx:vc.x,cy:vc.y,rx:10,ry:10,fill:null});rings.push({o,r:10});window._rippleObjs.push(o);}for(const rg of rings){rg.r+=6;rg.o.data.rx=rg.r;rg.o.data.ry=rg.r;}for(let k=rings.length-1;k>=0;k--){if(rings[k].r>440){const o=rings[k].o,all=BM.all(),i=all.indexOf(o);if(i>=0)all.splice(i,1);const j=window._rippleObjs.indexOf(o);if(j>=0)window._rippleObjs.splice(j,1);rings.splice(k,1);}}BM.redraw();},60);BM.log('🌊 ripple');"
    },
    {
      "name": "stars",
      "icon": "✨",
      "desc": "星がきらめく（もう一度で停止）",
      "author": "kinoshita studio",
      "tag": "new",
      "action": "if(window._starsId){clearInterval(window._starsId);window._starsId=null;if(window._starsObjs){const all=BM.all();for(const o of window._starsObjs){const i=all.indexOf(o);if(i>=0)all.splice(i,1);}window._starsObjs=null;BM.redraw();}BM.log('stars off');return;}const vc=BM.viewCenter(),W=1600,H=1000;window._starsObjs=[];for(let i=0;i<30;i++){const o=BM.create('text',{x:vc.x-W/2+Math.random()*W,y:vc.y-H/2+Math.random()*H,text:Math.random()<0.5?'✨':'⭐',fontSize:12+Math.random()*16});window._starsObjs.push(o);}window._starsId=setInterval(()=>{for(const o of window._starsObjs){if(Math.random()<0.16)o.data.text=o.data.text==='✨'?'⭐':'✨';}BM.redraw();},380);BM.log('✨ stars');"
    },
    {
      "name": "rainbow",
      "icon": "🌈",
      "desc": "全オブジェクトを虹色に染める",
      "author": "kinoshita studio",
      "tag": "new",
      "action": "const cols=['#FF5C5C','#FF9F43','#FFD24C','#5CFF9B','#5CC8FF','#5C7CFF','#9B5CFF'];let i=0;for(const o of BM.all()){const c=cols[i%cols.length];o.data.stroke=c;if(o.data.fill&&o.data.fill!=='none')o.data.fill=c;i++;}BM.redraw();BM.log('🌈 '+i+' objects');"
    }
  ]
}
